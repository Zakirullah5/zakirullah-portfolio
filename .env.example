# =======================================================
# ZAKIRULLAH PORTFOLIO & CMS - ENVIRONMENT TEMPLATE
# Copy this file to .env and configure your variables
# =======================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Security & Authentication
SESSION_SECRET="your-super-strong-jwt-session-secret-key-min-32-chars"
ADMIN_DEFAULT_EMAIL="admin@yourdomain.com"
ADMIN_DEFAULT_PASSWORD="your-secure-master-password"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Separate Frontend/Backend Deployment (Optional)
# If hosting Frontend on GitHub Pages and Backend on Render/Railway:
# Set VITE_API_URL to your Render backend URL (e.g. https://your-app.onrender.com) before building frontend
VITE_API_URL=""
# Set CORS_ORIGIN on backend (or leave "*" to allow all origins)
CORS_ORIGIN="*"

